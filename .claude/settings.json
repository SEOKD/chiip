{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/chiip_guard.py\" pre"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/code_guard.py\" pre",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__101aca71-f224-48d5-a4b3-c2f866dda943__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tv_budget.py\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/chiip_guard.py\" post"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/code_guard.py\" post",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__101aca71-f224-48d5-a4b3-c2f866dda943__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tv_budget.py\" post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__4056a804-908b-4b7a-b720-ace3a2bcabc9__.*|mcp__easyconomics__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/connector_watch.py\" post",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/code_guard.py\" post",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__101aca71-f224-48d5-a4b3-c2f866dda943__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tv_budget.py\" post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__4056a804-908b-4b7a-b720-ace3a2bcabc9__.*|mcp__easyconomics__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/connector_watch.py\" failure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
